# ========================================================
# MO Life OS - Production Environment Configuration
# ملف الإعدادات الموصى به لبيئة الإنتاج (Production)
# ========================================================

APP_NAME="MO Life OS"
APP_ENV=production
APP_KEY=base64:mo9IhZhQsWOlDQ5WKgexpGASmWMW1gIcaSupGEk3ox0=
APP_DEBUG=false
APP_URL=https://yourdomain.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# ========================================================
# إعدادات قاعدة البيانات (MySQL / MariaDB)
# ========================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_strong_password

# ========================================================
# إعدادات الجلسات والكاش وقوائم الانتظار
# ========================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# ========================================================
# إعدادات البريد الإلكتروني (SMTP) لإرسال التنبيهات واستعادة كلمة المرور
# ========================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notifications@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ========================================================
# إعدادات الذكاء الاصطناعي (Google Gemini API)
# ========================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ========================================================
# (اختياري) إعدادات محرك البحث الخارجي المخصص
# إذا تُرِك فارغاً، سيعتمد النظام تلقائياً على محرك DuckDuckGo وويكيبيديا المدمج
# ========================================================
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# ========================================================
# إعدادات واتساب لطلب إنشاء الحسابات
# رقم هاتف المشرف متضمناً كود الدولة (مثال: 2010xxxxxxxx أو 9665xxxxxxxx) بدون فواصل
# ========================================================
WHATSAPP_REGISTRATION_NUMBER=
WHATSAPP_REGISTRATION_MESSAGE="مرحباً، أود طلب إنشاء حساب جديد في منصة MO Life OS"
